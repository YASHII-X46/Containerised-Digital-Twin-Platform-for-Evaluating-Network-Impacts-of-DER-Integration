# Control panel (Node.js/Express) — Windows container (DT-Stack v5.0).
#
# The official Node.js images publish NO Windows variants, so Node is
# installed into Server Core from the nodejs.org zip. Pin NODE_VERSION to a
# current LTS; bump it deliberately rather than tracking "latest".
FROM mcr.microsoft.com/windows/servercore:ltsc2025

SHELL ["powershell", "-Command", "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue';"]

ARG NODE_VERSION=20.18.1

RUN Invoke-WebRequest -Uri \"https://nodejs.org/dist/v$env:NODE_VERSION/node-v$env:NODE_VERSION-win-x64.zip\" -OutFile node.zip; \
    Expand-Archive node.zip -DestinationPath C:\ ; \
    Rename-Item \"C:\node-v$env:NODE_VERSION-win-x64\" C:\nodejs; \
    Remove-Item node.zip -Force; \
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + ';C:\nodejs', [EnvironmentVariableTarget]::Machine)

WORKDIR C:\\app

COPY package.json ./
RUN npm install --omit=dev

COPY server.js ./
COPY bus.js ./
COPY public ./public

EXPOSE 3000

CMD ["node", "server.js"]
